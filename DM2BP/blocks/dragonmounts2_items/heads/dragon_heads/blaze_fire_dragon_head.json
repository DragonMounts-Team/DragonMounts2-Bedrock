      "minecraft:geometry": {
        "identifier": "geometry.dragonmounts2.head_block.base",
        "bone_visibility": {
          "bone": "q.block_state('minecraft:block_face')=='up'&&!math.mod(q.block_state('dragonmounts2:rotation'),4)",
          "bone.jaw": "q.block_state('minecraft:block_face')=='up'&&!math.mod(q.block_state('dragonmounts2:rotation'),4)",
          "rotate_22_5": "q.block_state('minecraft:block_face')=='up'&&!math.mod(q.block_state('dragonmounts2:rotation')-1,4)",
          "rotate_22_5.jaw": "q.block_state('minecraft:block_face')=='up'&&!math.mod(q.block_state('dragonmounts2:rotation')-1,4)",
          "rotate_45": "q.block_state('minecraft:block_face')=='up'&&!math.mod(q.block_state('dragonmounts2:rotation')-2,4)",
          "rotate_45.jaw": "q.block_state('minecraft:block_face')=='up'&&!math.mod(q.block_state('dragonmounts2:rotation')-2,4)",
          "rotate_67_5": "q.block_state('minecraft:block_face')=='up'&&!math.mod(q.block_state('dragonmounts2:rotation')-3,4)",
          "rotate_67_5.jaw": "q.block_state('minecraft:block_face')=='up'&&!math.mod(q.block_state('dragonmounts2:rotation')-3,4)"
        }
      },
      "minecraft:light_dampening": 0,
      "minecraft:loot": "loot_tables/blocks/dragonmounts2_items/heads/dragon_heads/fire_dragon/blaze_fire_dragon_head.json",
      "minecraft:material_instances": {
        "*": { "texture": "dragonmounts2:fire_dragon_head_blaze", "render_method": "alpha_test", "ambient_occlusion": 0.25, "face_dimming": false }
      },
      "minecraft:placement_filter": {
        "conditions": [
          { "allowed_faces": [ "up", "side" ] }
        ]
      },
      "minecraft:selection_box": { "origin": [-4,0,-4], "size": [8,8,8] }
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:block_face')=='up'&&q.block_state('dragonmounts2:rotation')>=4||q.block_state('minecraft:block_face')=='east'",
        "components": { "minecraft:transformation": { "rotation": [0,-90,0] } }
      },
      {
        "condition": "q.block_state('minecraft:block_face')=='up'&&q.block_state('dragonmounts2:rotation')>=8||q.block_state('minecraft:block_face')=='south'",
        "components": { "minecraft:transformation": { "rotation": [0,180,0] } }
      },
      {
        "condition": "q.block_state('minecraft:block_face')=='up'&&q.block_state('dragonmounts2:rotation')>=12||q.block_state('minecraft:block_face')=='west'",
        "components": { "minecraft:transformation": { "rotation": [0,90,0] } }
      },
      {
        "condition": "q.block_state('minecraft:block_face')!='up'",
        "components": {
          "minecraft:geometry": {
            "identifier": "geometry.dragonmounts2.head_block.base_back"
          },
          "minecraft:collision_box": { "origin": [-4,4,0], "size": [8,8,8] },
          "minecraft:selection_box": { "origin": [-4,4,0], "size": [8,8,8] }
        }
      }
    ]
