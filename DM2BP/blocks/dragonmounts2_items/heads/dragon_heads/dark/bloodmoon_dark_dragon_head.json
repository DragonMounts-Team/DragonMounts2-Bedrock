{
    "format_version": "1.26.40",
    "minecraft:block": {
        "description": {
            "identifier": "dragonmounts2:bloodmoon_dark_dragon_head",
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": ["minecraft:sixteen_way_rotation"],
                    "y_rotation_offset": 180
                },
                "minecraft:placement_position": {
                    "enabled_states": ["minecraft:block_face"]
                }
            }
        },
        "components": {
            "minecraft:collision_box": { "origin": [-4, 0, -4], "size": [8, 8, 8] },
            "minecraft:selection_box": { "origin": [-4, 0, -4], "size": [8, 8, 8] },
            "minecraft:connection_rule": { "accepts_connections_from": "none" },
            "minecraft:placement_filter": { "conditions": [{ "allowed_faces": ["up", "south", "north", "west", "east"] }] },
            "minecraft:precipitation_interactions": { "precipitation_behavior": "none" },
            "minecraft:destructible_by_explosion": { "explosion_resistance": 5 },
            "minecraft:destructible_by_mining": { "seconds_to_destroy": 1 },
            "minecraft:destruction_particles": { "particle_count": 48, "texture": "soul_sand" },
            "minecraft:display_name": "tile.dragonmounts2:dark_dragon_head.bloodmoon.name",
            "minecraft:loot": "loot_tables/blocks/dragonmounts2_items/heads/dragon_heads/dark/bloodmoon_dark_dragon_head.json",
            "minecraft:movable": { "movement_type": "popped" },
            "minecraft:liquid_detection": {
                "detection_rules": [
                    {
                        "liquid_type": "water",
                        "can_contain_liquid": true, 
                        "on_liquid_touches": "popped" 
                    }
                ]
            },
            "minecraft:material_instances": {
               "*": { "texture": "dragonmounts2:dark_dragon_head_bloodmoon", "render_method": "alpha_test", "ambient_occlusion": 0.25, "face_dimming": false }
            },
            "minecraft:geometry": { "identifier": "geometry.dragonmounts2.head_block.spiked_horned", "n_way_visual_rotation": { "y": "minecraft:sixteen_way_rotation" }
            }
        },
        "permutations": [
            {
                "condition": "q.block_state('minecraft:block_face') != 'up'",
                "components": {
                    "minecraft:geometry": "geometry.dragonmounts2.head_block.spiked_horned"
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [0, 0, 0],
                        "translation": [0, 0.25, 0.15]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [0, 90, 0],
                        "translation": [0.15, 0.25, 0]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [0, 180, 0],
                        "translation": [0, 0.25, -0.15]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [0, -90, 0],
                        "translation": [-0.15, 0.25, 0]
                    }
                }
            }
        ]
    }
}
