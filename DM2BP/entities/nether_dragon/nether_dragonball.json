{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "dragonmounts2:nether_dragonball",
      "runtime_identifier": "minecraft:fireball",
      "is_summonable": true,
      "is_spawnable": false,
      "properties": {
        "dragonmounts2:environmental_effects_enabled": {
          "type": "bool",
          "default": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "projectile",
          "fireball"
        ]
      },
      "minecraft:collision_box": {
        "height": 1.0,
        "width": 1.0
      },
      "minecraft:dimension_bound": {},
      "minecraft:physics": {},
      "minecraft:projectile": {
        "anchor": "middle",
        "gravity": 0.0,
        "catch_fire": true,
        "inertia": 1,
        "liquid_inertia": 1,
        "on_hit": {
          "definition_event": {
            "affect_projectile": true,
            "event_trigger": {
              "event": "minecraft:explode",
              "target": "self"
            }
          },
          "impact_damage": {
            "apply_knockback_to_blocking_targets": true,
            "damage": {
              "min": 6,
              "max": 6
            },
            "knockback": false
          }
        },
        "offset": [
          0,
          -1.5,
          0
        ],
        "power": 1.6,
        "reflect_on_hurt": true,
        "uncertainty_base": 0,
        "uncertainty_multiplier": 0,
        "isolated_physics": false
      },
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {}
    },
    "component_groups": {
      "minecraft:exploding": {
        "minecraft:explode": {
          "causes_fire": true,
          "fire_affected_by_griefing": true,
          "fuse_lit": true,
          "power": 5,
          "destroy_affected_by_griefing": true,
          "fuse_length": 0
        }
      },
      "dragonmounts2:exploding_no_environmental_effects": {
        "minecraft:explode": {
          "causes_fire": false,
          "fire_affected_by_griefing": false,
          "fuse_lit": true,
          "power": 5,
          "destroy_affected_by_griefing": false,
          "fuse_length": 0
        }
      }
    },
    "events": {
      "minecraft:explode": {
        "sequence": [
          {
            "filters": {
              "test": "bool_property",
              "subject": "self",
              "domain": "dragonmounts2:environmental_effects_enabled",
              "value": true
            },
            "add": {
              "component_groups": [
                "minecraft:exploding"
              ]
            }
          },
          {
            "filters": {
              "test": "bool_property",
              "subject": "self",
              "domain": "dragonmounts2:environmental_effects_enabled",
              "value": false
            },
            "add": {
              "component_groups": [
                "dragonmounts2:exploding_no_environmental_effects"
              ]
            }
          }
        ]
      }
    }
  }
}
