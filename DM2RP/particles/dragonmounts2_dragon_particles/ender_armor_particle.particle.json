{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dragonmounts2:ender_armor_particle",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/dragon/dragonmounts2"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "q.is_pack_setting_enabled('dragonmounts2:dragon_armor_particles') ? 0 : 30",
				"max_particles": 30
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.7
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, -0.5, 0],
				"radius": 1,
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1.7
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": 0.4,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [0.1, 0.1],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": ["variable.particle_random_3 < 0.5 ? math.round(variable.particle_random_2 * 14) * 8 + 8 : 0", "variable.particle_random_3 < 0.5 ? 0 : math.round(variable.particle_random_2 * 0) * 8"],
						"size_UV": [8, 8],
						"step_UV": [8, 0],
						"frames_per_second": 6,
						"max_frame": 9,
						"stretch_to_lifetime": true,
						"loop": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.2,
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FF733787",
						"1.0": "#FF231431"
					}
				}
			}
		}
	}
}