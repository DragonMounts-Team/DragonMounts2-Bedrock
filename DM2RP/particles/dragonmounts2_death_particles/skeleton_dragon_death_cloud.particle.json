{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dragonmounts2:skeleton_dragon_death_cloud",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/dragon/campfire_smoke"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "q.is_pack_setting_enabled('dragonmounts2:dragon_particles') ? 0 : 100",
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 10
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [
					0,
					1,
					0
				],
				"radius": "math.random(0,4)",
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1,2)"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					"math.random(2,4)",
					0
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					0.25,
					0.25
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 192,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							16,
							16
						],
						"step_UV": [
							0,
							16
						],
						"frames_per_second": 20,
						"max_frame": 16,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ADFFFFFF",
						"0.31": "#FF8F8F8F",
						"0.5": "#FFFFFFFF",
						"0.75": "#FF616161",
						"1.0": "#FF7E7E7E"
					}
				}
			}
		}
	}
}