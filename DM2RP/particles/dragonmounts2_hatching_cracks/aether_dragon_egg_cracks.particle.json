{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dragonmounts2:aether_dragon_egg_cracks",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/egg/egg_crack"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "q.is_pack_setting_enabled('dragonmounts2:dragon_egg_particles') ? 0 : 64",
				"max_particles": 64
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.4
			},
			"minecraft:emitter_shape_point": {
				"offset": ["0+Math.random(-0.2, 0.2)", "1+Math.random(-0.2, -0.8)", "0+Math.random(-0.2, 0.2)"],
				"direction": ["0+Math.random(-2.0, 2.0)", "0+Math.random(-2.0, 2.0)", "0+Math.random(-2.0, 2.0)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(1.2, 3.2)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": "Math.random(2, 6)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -9.8, 0],
				"linear_drag_coefficient": 0.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.particle_random_1 * 0.04 + 0.04", "variable.particle_random_1 * 0.04 + 0.04"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 90,
					"uv": ["variable.particle_random_3 > -1 ? Math.round(variable.particle_random_2 * 2) * 5.5 + 0: Math.round(variable.particle_random_2 * 2)", 0],
					"uv_size": [5, 5]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 5,
				"coefficient_of_restitution": 0.2,
				"collision_radius": 0.1
			}
		}
	}
}
