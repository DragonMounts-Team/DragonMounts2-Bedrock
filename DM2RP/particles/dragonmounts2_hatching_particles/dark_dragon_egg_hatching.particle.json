{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dragonmounts2:dark_dragon_egg_hatching",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/dragon/dragonmounts2"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "q.is_pack_setting_enabled('dragonmounts2:dragon_egg_particles') ? 0 : 16",
				"max_particles": 16
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.4
			},
			"minecraft:emitter_shape_point": {
				"offset": ["Math.random(-0.6, 0.6)", "Math.random(-1.0, 0.9)", "Math.random(-0.6, 0.6)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(1.0, 3.2)"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["Math.random(-2.0, 2.0)", "Math.random(-0.1, 0.3)", "Math.random(-2.0, 2.0)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.12, 0.12],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [8, 8],
						"step_UV": [8, 0],
						"frames_per_second": 2,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFF20202",
						"0.5": "#FF4E030F",
						"1.0": "#FF840214"
					}
				}
			}
		}
	}
