{
  "namespace": "chest",
  "dragon_core_chest_slot": {
    "type": "grid",
    "size": [18, 18],
    "anchor_from": "center",
    "anchor_to": "center",
    "grid_dimensions": [1, 1],
    "grid_item_template": "chest.chest_grid_item",
    "collection_name": "container_items"
  },
  "dragon_core_essence_cycler@common.image_cycler": {
    "size": [26, 26],
    "anchor_from": "center",
    "anchor_to": "center",
    "images": [
      { "texture_path": "textures/ui/dragonmounts2/essence/essence" },
      { "texture_path": "textures/ui/dragonmounts2/essence/essence_aether" },
      { "texture_path": "textures/ui/dragonmounts2/essence/essence_enchanted" },
      { "texture_path": "textures/ui/dragonmounts2/essence/essence_ender" },
      { "texture_path": "textures/ui/dragonmounts2/essence/essence_fire" },
      { "texture_path": "textures/ui/dragonmounts2/essence/essence_ice" },
      { "texture_path": "textures/ui/dragonmounts2/essence/essence_moonlight" },
      { "texture_path": "textures/ui/dragonmounts2/essence/essence_nether" },
      { "texture_path": "textures/ui/dragonmounts2/essence/essence_storm" },
      { "texture_path": "textures/ui/dragonmounts2/essence/essence_sunlight" },
      { "texture_path": "textures/ui/dragonmounts2/essence/essence_water" },
      { "texture_path": "textures/ui/dragonmounts2/essence/essence_wither" }
    ]
  },
  "dragon_core_cycle_arrow": {
    "type": "button",
    "size": [14, 18],
    "layer": 4,
    "anchor_from": "center",
    "anchor_to": "center",
    "focus_enabled": true,
    "$cycle_event|default": "button.cast_subpage_left",
    "$arrow_texture|default": "textures/ui/chevron_left",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$cycle_event",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$cycle_event",
        "mapping_type": "focused"
      }
    ],
    "controls": [
      {
        "default": {
          "type": "image",
          "size": [5, 7],
          "texture": "$arrow_texture"
        }
      },
      {
        "hover@common.focus_border_white": {
          "size": ["100%", "100%"]
        }
      },
      {
        "pressed": {
          "type": "image",
          "size": [5, 7],
          "texture": "$arrow_texture",
          "alpha": 0.6
        }
      }
    ]
  },
  "dragon_core_cycle_left@chest.dragon_core_cycle_arrow": {
    "$cycle_event": "button.cast_subpage_left",
    "$arrow_texture": "textures/ui/chevron_left",
    "offset": [-25, -10]
  },
  "dragon_core_cycle_right@chest.dragon_core_cycle_arrow": {
    "$cycle_event": "button.cast_subpage_right",
    "$arrow_texture": "textures/ui/chevron_right",
    "offset": [25, -10]
  },
  "dragon_core_panel_top_half": {
    "type": "panel",
    "size": ["100%", "50%"],
    "offset": [0, 12],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "controls": [
      {
        "chest_label@chest.chest_label": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "text_alignment": "center",
          "size": ["100%", "default"]
        }
      },
      {
        "essence_preview@chest.dragon_core_essence_cycler": {
          "offset": [0, -10]
        }
      },
      {
        "previous_essence@chest.dragon_core_cycle_left": {}
      },
      {
        "next_essence@chest.dragon_core_cycle_right": {}
      },
      {
        "essence_slot@chest.dragon_core_chest_slot": {
          "offset": [0, 20]
        }
      }
    ]
  },
  "dragon_core_panel": {
    "type": "panel",
    "controls": [
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {}
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {}
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {}
      },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "controls": [
            {
              "common_panel@common.common_panel": {}
            },
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  {
                    "dragon_core_panel_top_half@chest.dragon_core_panel_top_half": {}
                  },
                  {
                    "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
                  },
                  {
                    "hotbar_grid@common.hotbar_grid_template": {}
                  },
                  {
                    "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                  },
                  {
                    "flying_item_renderer@common.flying_item_renderer": {
                      "layer": 15
                    }
                  }
                ]
              }
            },
            {
              "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
            },
            {
              "gamepad_cursor@common.gamepad_cursor_button": {}
            }
          ]
        }
      }
    ]
  },
  "dragon_core_pocket_slot_item@common.pocket_ui_container_item": {
    "$item_collection_name": "container_items"
  },
  "dragon_core_pocket_slot": {
    "type": "grid",
    "size": [28, 28],
    "anchor_from": "center",
    "anchor_to": "center",
    "grid_dimensions": [1, 1],
    "grid_item_template": "chest.dragon_core_pocket_slot_item",
    "collection_name": "container_items"
  },
  "dragon_core_pocket_panel": {
    "type": "panel",
    "controls": [
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {
          "layer": 3
        }
      },
      {
        "header@pocket_containers.header_area": {
          "layer": 2
        }
      },
      {
        "background@pocket_containers.background_panel": {
          "layer": 0
        }
      },
      {
        "player_inventory@pocket_containers.half_screen": {
          "$container_size": 36,
          "$pane_collection": "combined_hotbar_and_inventory_items"
        }
      },
      {
        "core_container": {
          "type": "panel",
          "size": ["50%", "100% - 27px"],
          "offset": [0, 27],
          "anchor_from": "top_middle",
          "anchor_to": "top_left",
          "controls": [
            {
              "essence_preview@chest.dragon_core_essence_cycler": {
                "offset": [0, "50% - 20px"]
              }
            },
            {
              "previous_essence@chest.dragon_core_cycle_left": {
                "offset": ["50% - 25px", "50% - 20px"]
              }
            },
            {
              "next_essence@chest.dragon_core_cycle_right": {
                "offset": ["50% + 25px", "50% - 20px"]
              }
            },
            {
              "essence_slot@chest.dragon_core_pocket_slot": {
                "offset": ["50%", "50% + 19px"]
              }
            }
          ]
        }
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {}
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {
          "$offset": [0, "85%"]
        }
      },
      {
        "gamepad_cursor@common.gamepad_cursor_button": {}
      },
      {
        "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
      },
      {
        "hold_icon@common.inventory_take_progress_icon_button": {}
      },
      {
        "flying_item_renderer@common.flying_item_renderer": {
          "layer": 12
        }
      }
    ]
  }
}
