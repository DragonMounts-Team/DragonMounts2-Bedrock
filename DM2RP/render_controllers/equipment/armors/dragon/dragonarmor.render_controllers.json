{
    "format_version": "1.26.10",
    "render_controllers": {
      "controller.render.dragonarmor.default": {
        "geometry": "Geometry.default",
        "materials": [ { "*": "v.is_enchanted?Material.enchanted:Material.default" } ],
        "textures": [ "v.has_trim?v.trim_path:Texture.default", "Texture.enchanted" ]
      },
      "controller.render.dragonarmor.dyeable": {
        "geometry": "Geometry.default",
        "materials": [ { "*": "v.is_enchanted?Material.enchanted:Material.default" } ],
        "textures": [ "v.has_trim?v.trim_path:Texture.dyed", "Texture.enchanted" ]
      },
      "controller.render.dragonarmor.overlay": {
        "geometry": "Geometry.default",
        "materials": [ { "*": "v.is_enchanted?Material.overlay_enchanted:Material.overlay" } ],
        "textures": [ "v.has_trim?v.trim_path:Texture.overlay", "Texture.enchanted" ]
      }
    }
  }
