{
  "format_version": "1.26.10",
  "minecraft:attachable": {
    "description": {
      "identifier": "dragonmounts2:ender_dragon_scale_chestplate",
      "materials": { "default": "armor", "enchanted": "armor_enchanted" },
      "textures": {
        "default": "textures/models/dragonmounts2_equipment/armor_equipment/ender_classic",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": { "default": "geometry.dragonmounts2.dragon_scale.chestplate" },
      "particle_effects": { "ender_particles": "dragonmounts2:ender_armor_particle" },
      "animations": {
        "cape":          "animation.dragonmounts2.player.cape",
        "particle_loop": "animation.dragonmounts2.dragon_scale.chestplate.particles"
      },
      "scripts": {
        "initialize": [
          "v.not_armor_stand = !q.is_owner_identifier_any('minecraft:armor_stand');"
        ],
        "pre_animation": [
          "v.has_helmet    = q.is_item_name_any('slot.armor.head', 0, 'dragonmounts2:ender_dragon_scale_helmet');",
          "v.particle_gate = v.not_armor_stand * (1.0 - v.has_helmet);"
        ],
        "parent_setup": "v.chest_layer_visible = 0.0;",
        "animate": [
          "cape",
          { "particle_loop": "v.particle_gate" }
        ]
      },
      "render_controllers": [ "controller.render.dragon_scale_armor" ]
    }
  }
}