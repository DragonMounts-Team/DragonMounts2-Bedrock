{
  "format_version": "1.26.10",
  "minecraft:attachable": {
    "description": {
      "identifier": "dragonmounts2:ender_dragon_scale_helmet",
      "materials": { "default": "armor", "enchanted": "armor_enchanted" },
      "textures": {
        "default": "textures/models/dragonmounts2_equipment/armor_equipment/ender_classic",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": { "default": "geometry.dragonmounts2.dragon_scale.helmet" },
      "particle_effects": { "ender_particles": "dragonmounts2:ender_armor_particle" },
      "animations": { "particle_loop": "animation.dragonmounts2.dragon_scale.helmet.particles" },
      "scripts": {
        "initialize": [
          "v.not_armor_stand = !q.is_owner_identifier_any('minecraft:armor_stand');"
        ],
        "pre_animation": [
          "v.particle_gate = v.not_armor_stand;"
        ],
        "parent_setup": "v.helmet_layer_visible = 0.0;",
        "animate": [
          { "particle_loop": "v.particle_gate" }
        ]
      },
      "render_controllers": [ "controller.render.armor" ]
    }
  }
}