        "pre_animation": [ "v.age_variant = q.property('dragonmounts2:age_variant');", "v.is_adult = v.age_variant=='adult';", "v.is_juvenile = v.age_variant=='juvenile';", "v.is_baby = v.age_variant=='baby';", "v.age_variant_index = v.is_adult?0:v.is_juvenile?1:v.is_baby?2:0;", "v.roar_len = q.property('dragonmounts2:roar_ticks')/20;", "v.is_roaring = v.roar_len>0;", "v.death_ticks = q.property('dragonmounts2:death_ticks');", "v.death_effect_duration = 2.00;", "v.death_alpha = (1.0-((v.death_ticks/2)/v.death_effect_duration));", "v.script_ride = q.has_rider;", "v.bite_anim_duration = 0.75f;", "v.is_breathing = q.property('dragonmounts2:is_breathing');", "v.breath_ready = q.property('dragonmounts2:breath_ready');", "v.variant_type = q.property('dragonmounts2:variant_type');", "v.is_fallen = v.variant_type=='fallen';", "v.is_prism = v.variant_type=='prism';", "v.is_radiant = v.variant_type=='radiant';", "v.is_sunset = v.variant_type=='sunset';", "v.variant_type_index = v.is_fallen?0:v.is_prism?1:v.is_radiant?2:v.is_sunset?3:0;", "v.has_collar = q.property('dragonmounts2:has_collar');", "v.equipped_armor = !q.is_item_name_any('slot.armor.chest','')||!q.is_item_name_any('slot.armor.body','');", "v.mob_state = q.property('dragonmounts2:mob_state');", "v.is_standing = v.mob_state=='standing';", "v.is_sitting = v.mob_state=='sitting';", "v.movement_state = q.property('dragonmounts2:movement_state');", "v.is_grounded_legacy = v.movement_state=='grounded';", "v.is_flying = v.movement_state=='flying';", "v.is_swimming = v.movement_state=='swimming';", "v.is_grounded = v.is_grounded_legacy||v.is_swimming;", "v.tail_movement = math.lerp(v.tail_movement,(q.property('dragonmounts2:movement_state')=='flying'?q.property('dragonmounts2:flight_roll'):q.yaw_speed), 0.35);", "v.body_roll = math.lerp(v.body_roll,(q.property('dragonmounts2:movement_state')=='flying'?q.property('dragonmounts2:flight_roll'):q.yaw_speed), 0.35);" ],
